{
  "name": "odin-cockpit",
  "private": true,
  "type": "module",
  "description": "Cockpit de acompanhamento de saúde do Odin, publicado no GitHub Pages",
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:landing": "node scripts/check-landing.mjs",
    "smoke": "node scripts/build-app.mjs && node tests/smoke.mjs",
    "app:build": "node scripts/build-app.mjs",
    "app:ver": "node scripts/build-app.mjs && npx --yes serve app/public -l 5050",
    "deploy:verificar": "node scripts/verificar-deploy.mjs",
    "publicar": "node scripts/publicar.mjs",
    "ver": "npx --yes serve docs -l 4173",
    "bdd": "node scripts/build-app.mjs && cucumber-js",
    "producao:conferir": "node scripts/conferir-producao.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.63.0",
    "playwright": "1.63.0"
  }
}
