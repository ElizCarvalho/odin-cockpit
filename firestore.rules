rules_version = '2';
// Acesso por e-mail Google verificado, com papel em acl/users.roles: admin | edit | view.
// O primeiro login cria a lista com o próprio e-mail como admin.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    function aclPath() { return /databases/$(database)/documents/acl/users; }
    function acl() { return get(aclPath()).data; }
    function member() { return signedIn() && exists(aclPath()) && me() in acl().emails; }
    function role() { return acl().get('roles', {}).get(me(), 'view'); }
    function canEdit() { return member() && role() in ['admin', 'edit']; }
    function isAdmin() { return member() && role() == 'admin'; }
    function onlyMeAdmin(d) { return d.roles.keys().hasOnly([me()]) && d.roles[me()] == 'admin'; }

    match /acl/users {
      allow read: if member() || (signedIn() && !exists(aclPath()));
      allow create: if signedIn() && !exists(aclPath()) && request.resource.data.emails == [me()] && onlyMeAdmin(request.resource.data);
      // admin mexe em tudo (sem se tirar); antes de existir papéis, quem já está na lista vira o primeiro admin
      allow update: if (isAdmin() && me() in request.resource.data.emails && request.resource.data.roles.get(me(), '') == 'admin')
        || (member() && !('roles' in resource.data) && request.resource.data.emails == resource.data.emails && onlyMeAdmin(request.resource.data));
    }
    // cada aparelho grava o próprio token de push
    match /tokens/{tok} {
      allow create, update: if member() && request.resource.data.email == me();
      allow delete: if member();
      allow read: if isAdmin();
    }
    // registro de quem fez o quê: só admin lê; ninguém edita nem apaga (as funções gravam criação/edição; o app grava as exclusões)
    match /auditoria/{id} {
      allow read: if isAdmin();
      allow create: if canEdit() && request.resource.data.by == me() && request.resource.data.acao == 'apagou';
    }
    // pesquisa da landing (Munin): só a função grava; respostas e métricas só admin lê; contatos ninguém lê pelo app
    match /pesquisa_respostas/{id} { allow read: if isAdmin(); }
    match /pesquisa_metricas/{id} { allow read: if isAdmin(); }
    match /{col}/{id} {
      allow read: if member() && !(col in ['acl', 'auditoria', 'pesquisa_respostas', 'pesquisa_contatos', 'pesquisa_metricas', 'pesquisa_limites']);
      // o app carimba _by/_byName/_at em toda escrita (shim.js) e a função grava a trilha em "auditoria"
      allow create, update: if canEdit() && !(col in ['acl', 'tokens', 'auditoria', 'pesquisa_respostas', 'pesquisa_contatos', 'pesquisa_metricas', 'pesquisa_limites']);
      allow delete: if canEdit() && !(col in ['acl', 'tokens', 'auditoria', 'pesquisa_respostas', 'pesquisa_contatos', 'pesquisa_metricas', 'pesquisa_limites']);
    }
  }
}
